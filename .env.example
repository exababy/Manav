# Sunucu portu
PORT=3000
# Saat dilimi (fiş tarih/saat için)
TZ=Europe/Istanbul

# Veritabanı: sqlite (varsayılan) veya mysql
DB_CLIENT=sqlite
SQLITE_FILE=./data/manav.db

# MySQL kullanmak için DB_CLIENT=mysql yapıp aşağıyı doldurun
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=yns_tarim

# Oturum anahtarı (boş bırakılırsa otomatik üretilip veritabanına kaydedilir)
APP_SECRET=
